  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "MAIN OBJECTIVE\r\nPlay classic Blackjack (21). Your goal is to survive
    a specific number of hands to clear the Round and reach the Shop. The game ends
    if you lose all your lives (\u2665) or go bankrupt!\r\nSHOP POWER-UPS\r\nUse
    your winnings at the Shop to buy these powerful items to help you survive the
    increasingly difficult rounds:\r\n\U0001F4B0 2x Money: Doubles the payout of
    your next winning hand.\r\n\U0001F3B2 Dice: Allows you to reroll your drawn cards
    if you are about to Bust.\r\n\U0001F91D Handshake: Force the Dealer to declare
    a Tie (Push) - you get your bet back regardless of the cards.\r\n\U0001F4BC Money
    Bag: Instantly grants a significant cash bonus to your budget.\r\n\U0001F48A
    Pill: Restores one lost life (\u2665).\r\n\U0001F52B Revolver: Destroys the Dealer's
    highest visible card.\r\n\U0001F6E1\uFE0F Shield: Prevents the loss of a life
    (\u2665) if you lose the next hand.\r\n\u23ED\uFE0F Skip Hand: Safely skip the
    current hand without losing money or lives. It still counts towards your round
    progress!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
