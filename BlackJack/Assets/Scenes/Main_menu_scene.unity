  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Blackjack Rules\n\nGoal \u2013 get a card total as close to 21 as possible
    without going over 21.\n\nCard Values\n\n2\u201310 \u2013 worth their number
    value\nJ, Q, K \u2013 worth 10 points\nAce \u2013 worth 1 or 11 points\n\nPlayer
    Actions\n\nHit \u2013 take an additional card.\n\nStand \u2013 stop and take
    no more cards.\n\nDouble Down \u2013 double the bet and take only one additional
    card.\n\nSplit \u2013 if the first two cards have the same value, they can be
    split into two separate hands.\nEach hand receives one new card and is played
    separately.\n\nBlackjack \u2013 if the first two cards make 21 points, meaning
    an Ace + 10/J/Q/K, it is Blackjack and usually an automatic win.\n\nDealer Rules\n\nThe
    dealer must draw cards until they have at least 17 points.\n\nWinning and Losing\n\nIf
    the player goes over 21, the player loses.\n\nIf the dealer goes over 21, the
    player wins.\n\nIf both the player and dealer stay at 21 or below, the higher
    total wins.\n\nIf the totals are equal, it is a tie, called a Push."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
